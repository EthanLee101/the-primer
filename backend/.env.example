# Local dev (Docker Compose). For Neon in prod, use the connection string
# Neon gives you with +psycopg after postgresql and ?sslmode=require appended:
# postgresql+psycopg://user:pass@ep-xxx.neon.tech/primer?sslmode=require
DATABASE_URL=postgresql+psycopg://primer:primer@localhost:5432/primer

# "fake" (default) gives deterministic wrong-answer explanations with no
# network call — safe for dev/tests, and what the automated test suite
# always forces regardless of this file (see tests/conftest.py). Switch to
# "gemini" + a real key below only when you want to manually try the real
# explanations in the browser.
LLM_PROVIDER=fake
GEMINI_API_KEY=

# JSON array — the frontend's dev server origin. Add the deployed Vercel URL here too, later.
CORS_ORIGINS=["http://localhost:5173"]

# per-IP; applies to POST /attempts/{id}/answer, the endpoint that calls
# Gemini. Keeps free-tier usage bounded — see app/rate_limit.py.
ANSWER_RATE_LIMIT=20/minute
