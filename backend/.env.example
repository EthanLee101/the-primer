# Local dev (Docker Compose). For Neon in prod, use the connection string
# Neon gives you with +psycopg after postgresql and ?sslmode=require appended:
# postgresql+psycopg://user:pass@ep-xxx.neon.tech/primer?sslmode=require
DATABASE_URL=postgresql+psycopg://primer:primer@localhost:5432/primer
LLM_PROVIDER=fake
GEMINI_API_KEY=
# JSON array — the frontend's dev server origin. Add the deployed Vercel URL here too, later.
CORS_ORIGINS=["http://localhost:5173"]
