# Local dev (Docker Compose). For Neon in prod, use the connection string
# Neon gives you with +psycopg after postgresql and ?sslmode=require appended:
# postgresql+psycopg://user:pass@ep-xxx.neon.tech/primer?sslmode=require
DATABASE_URL=postgresql+psycopg://primer:primer@localhost:5432/primer

# "fake" (default) gives deterministic wrong-answer explanations with no
# network call — safe for dev/tests, and what the automated test suite
# always forces regardless of this file (see tests/conftest.py). Switch to
# "gemini" + a real key below only when you want to manually try the real
# explanations in the browser.
LLM_PROVIDER=fake
GEMINI_API_KEY=

# JSON array — the frontend's dev server origin(s). Vite falls back to the next
# free port (5173, 5174, ...) when one's taken, and localhost/127.0.0.1 count as
# different origins to the browser, so list both forms for the ports you use.
# Add the deployed Vercel URL here too, later.
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:5174", "http://127.0.0.1:5174"]

# per-IP; applies to POST /attempts/{id}/answer, the endpoint that calls
# Gemini. Keeps free-tier usage bounded — see app/rate_limit.py.
ANSWER_RATE_LIMIT=20/minute

# per-IP; applies to POST /parents and POST /parents/login (brute-force /
# credential-stuffing protection). Tighter than ANSWER_RATE_LIMIT on purpose.
AUTH_RATE_LIMIT=5/minute

# per-IP; applies to POST /children and POST /children/{id}/problems —
# unauthenticated by design, previously unlimited. Generic abuse/spam
# prevention, not tied to an external API's cost like ANSWER_RATE_LIMIT.
GENERAL_RATE_LIMIT=30/minute

# Signs parent session tokens. If unset, a random key is generated at
# process startup — fine for dev (just means existing sessions are
# invalidated every restart), but production MUST set a real, stable value,
# or every deploy silently logs every parent out. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=
